#
# Automatically generated make config: don't edit
# OpenPicoRTOS v1.9.x Configuration
#
# CONFIG_8051 is not set
# CONFIG_ARM is not set
# CONFIG_AVR is not set
# CONFIG_C2000 is not set
# CONFIG_HCS08 is not set
# CONFIG_MIPS is not set
CONFIG_MSP430=y
# CONFIG_POWERPC is not set
# CONFIG_RISCV is not set
# CONFIG_STM8 is not set
# CONFIG_Z80 is not set
# CONFIG_PTHREAD is not set
# CONFIG_WIN32 is not set
CONFIG_CC="gcc"
CONFIG_CC_GCC=y

#
# MSP430 architecture
#
CONFIG_MACH_MSP430G2553=y
CONFIG_ACLK_FREQ=32768

#
# Scheduler options
#
CONFIG_DISABLE_SINGLE_CORE=y
CONFIG_DISABLE_SMP=y
CONFIG_LITE=y
CONFIG_CORE_COUNT=1

#
# General setup
#
CONFIG_FIXED_TICK_HZ=y

#
# System tick frequency (in hertz) is defined by arch
#
CONFIG_TASK_COUNT=2
CONFIG_DEFAULT_STACK_COUNT=32
CONFIG_DEADLOCK_COUNT=1000

#
# Build configuration
#
CONFIG_CROSS_COMPILE="msp430-"
# CONFIG_CC_NO_OPTIMIZATION is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE1 is not set
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE2 is not set
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE3 is not set
# CONFIG_DEBUG is not set
# CONFIG_NDEBUG is not set
CONFIG_MAP=y
CONFIG_EXTRA_CFLAGS="-g"
CONFIG_LDSCRIPT="ldscripts/msp430g2553.ld"
CONFIG_EXTRA_LDFLAGS=""
# CONFIG_FPU is not set
# CONFIG_CACHE is not set
# CONFIG_MPU is not set

