#
# Automatically generated make config: don't edit
# OpenPicoRTOS v1.9.x Configuration
#
# CONFIG_8051 is not set
CONFIG_ARM=y
# CONFIG_AVR is not set
# CONFIG_C2000 is not set
# CONFIG_HCS08 is not set
# CONFIG_MIPS is not set
# CONFIG_POWERPC is not set
# CONFIG_RISCV is not set
# CONFIG_STM8 is not set
# CONFIG_PTHREAD is not set
# CONFIG_WIN32 is not set
CONFIG_CC="gcc"
CONFIG_CC_GCC=y

#
# ARM architecture
#
CONFIG_ARMV6M=y
# CONFIG_ARMV7M is not set
# CONFIG_ARMV7EM is not set
CONFIG_MACH_RP2040=y
# CONFIG_MPU_PMSAV6 is not set
CONFIG_STUB_NEWLIB_4_4_0=y

#
# Scheduler options
#
CONFIG_SINGLE_CORE=y
# CONFIG_SMP is not set
# CONFIG_LITE is not set
CONFIG_CORE_COUNT=1

#
# General setup
#
CONFIG_TICK_HZ=10000
CONFIG_TASK_COUNT=10
CONFIG_DEFAULT_STACK_COUNT=256
CONFIG_DEADLOCK_COUNT=10000

#
# Build configuration
#
CONFIG_CROSS_COMPILE="arm-none-eabi-"
CONFIG_CC_NO_OPTIMIZATION=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE1 is not set
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE2 is not set
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE3 is not set
CONFIG_DEBUG=y
# CONFIG_NDEBUG is not set
CONFIG_MAP=y
CONFIG_EXTRA_CFLAGS=""
CONFIG_LDSCRIPT="../common/ldscripts/rp2040_ram.ld"
CONFIG_EXTRA_LDFLAGS=""
# CONFIG_FPU is not set
# CONFIG_CACHE is not set
# CONFIG_MPU is not set

#
# Inter-Process communications
#
# CONFIG_FUTEX is not set
CONFIG_MUTEX=y
CONFIG_COND=y
# CONFIG_QUEUE is not set

#
# Device drivers
#

#
# ADC drivers
#
CONFIG_ADC_RP2040=y
# CONFIG_ADC_SAM3X is not set
# CONFIG_ADC_SAME5X is not set
# CONFIG_ADC_RENESAS_RA4 is not set
# CONFIG_ADC_STM32H7XX_SAR is not set
# CONFIG_ADC_ATMEL_AFEC is not set

#
# CAN drivers
#
# CONFIG_CAN_TI_DCAN is not set
# CONFIG_CAN_ATSAM3X is not set
# CONFIG_CAN_NXP_FLEXCAN is not set
# CONFIG_CAN_BOSCH_MCAN is not set

#
# Clock drivers
#
CONFIG_CLOCK_RP2040=y
# CONFIG_CLOCK_ATSAM3X is not set
# CONFIG_CLOCK_ATSAME5X is not set
# CONFIG_CLOCK_STM32H7XX is not set
# CONFIG_CLOCK_RENESAS_RA4 is not set
# CONFIG_CLOCK_ATMEL_PMC is not set

#
# DMA drivers
#
CONFIG_DMA_RP2040=y
# CONFIG_DMA_ATSAME5X is not set
# CONFIG_DMA_STM32H7XX is not set

#
# EEPROM drivers
#
# CONFIG_EEPROM_CY15B004J is not set

#
# Flash drivers
#
# CONFIG_FLASH_SAME5X is not set
# CONFIG_FLASH_ATMEL_EEFC is not set

#
# External flash drivers
#
# CONFIG_FLASH_EXT_SST26VF is not set
# CONFIG_FLASH_EXT_S25FL1 is not set

#
# GPIO drivers
#
CONFIG_GPIO_RP2040=y
# CONFIG_GPIO_ATSAM3X is not set
# CONFIG_GPIO_ATSAME5X is not set
# CONFIG_GPIO_STM32H7XX is not set
# CONFIG_GPIO_RENESAS_RA4 is not set
# CONFIG_GPIO_ATMEL_PIO is not set

#
# Misc. drivers
#
CONFIG_MISC_RP2040_RESET=y
# CONFIG_MISC_STM32H7XX_DMAMUX is not set
# CONFIG_MISC_ATSAMX7X_MATRIX is not set
# CONFIG_MISC_ATSAMX7X_RSTC is not set

#
# MUX drivers
#
CONFIG_MUX_RP2040=y
# CONFIG_MUX_ATSAM3X is not set
# CONFIG_MUX_ATSAME5X is not set
# CONFIG_MUX_STM32H7XX is not set
# CONFIG_MUX_RENESAS_RA4 is not set
# CONFIG_MUX_ATMEL_PIO is not set

#
# PWM drivers
#
CONFIG_PWM_RP2040=y
# CONFIG_PWM_ATSAM3X is not set
# CONFIG_PWM_ATSAM3X_TC is not set
# CONFIG_PWM_ATSAME5X is not set
# CONFIG_PWM_STM32H7XX is not set
# CONFIG_PWM_RENESAS_RA4_GPT is not set
# CONFIG_PWM_ATSAMX7X is not set
# CONFIG_PWM_ATSAMX7X_TC is not set

#
# RNG drivers
#
# CONFIG_RNG_XORSHIFT32 is not set

#
# SPI drivers
#
CONFIG_SPI_ARM_PL022=y
# CONFIG_SPI_ATMEL_SERCOM is not set
# CONFIG_SPI_ATSAM3X is not set
# CONFIG_SPI_STM32H7XX is not set
# CONFIG_SPI_RENESAS_RA4 is not set
# CONFIG_SPI_ATSAMX7X is not set
# CONFIG_SPI_ATSAMX7X_QSPI is not set

#
# TWI/I2C drivers
#
# CONFIG_TWI_ATMEL_SERCOM is not set
CONFIG_TWI_DW_APB_I2C=y
# CONFIG_TWI_ATSAM3X is not set

#
# UART drivers
#
CONFIG_UART_ARM_PL011=y
# CONFIG_UART_ATMEL_SERCOM is not set
# CONFIG_UART_ATSAM3X is not set
# CONFIG_UART_STM32H7XX is not set
# CONFIG_UART_RENESAS_RA4_SCI is not set
# CONFIG_UART_ATSAMX7X is not set
# CONFIG_UART_ATSAMX7X_USART is not set

#
# Watchdog drivers
#
CONFIG_WD_RP2040=y
# CONFIG_WD_ATSAM3X is not set
# CONFIG_WD_ATSAME5X is not set
# CONFIG_WD_STM32H7XX_IWDG is not set
# CONFIG_WD_ATMEL_WDT is not set
# CONFIG_STAGING is not set
